# Cloudformation stacks
alias awsls-stacks='aws cloudformation list-stacks --stack-status-filter CREATE_COMPLETE UPDATE_COMPLETE --query "StackSummaries[*].{Name:StackName,Status:StackStatus,Updated:LastUpdatedTime}" --output table'

awscf-validate() {
  aws cloudformation validate-template --template-body "file://$1"
}

awscf-events() {
  aws cloudformation describe-stack-events --stack-name "$1" --query "StackEvents[*].{Timestamp:Timestamp,Status:ResourceStatus,Type:ResourceType,ID:LogicalResourceId,Reason:ResourceStatusReason}" --output table
}

awscf-resources() {
  aws cloudformation describe-stack-resources --stack-name "$1" --query "StackResources[*].{ID:LogicalResourceId,Type:ResourceType,Status:ResourceStatus,Timestamp:Timestamp}" --output table
}

awscf-outputs() {
