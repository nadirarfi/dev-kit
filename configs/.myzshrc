# Pods management
alias kgp='kubectl get pods'
alias kgpw='kubectl get pods -o wide'  # Show pods with more details
alias kgpall='kubectl get pods --all-namespaces'  # Get pods across all namespaces
alias kgpa='kubectl get pods --all-namespaces'
alias kgpwatch='kubectl get pods --watch'  # Watch pods in real-time
