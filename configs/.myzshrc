# Path to your oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Set theme
ZSH_THEME="robbyrussell"

# Enable command auto-correction
ENABLE_CORRECTION="true"

# Display red dots while waiting for completion
COMPLETION_WAITING_DOTS="true"

# History settings
HIST_STAMPS="yyyy-mm-dd"
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_REDUCE_BLANKS

# Oh My Zsh plugins
# Note: you must install zsh-autosuggestions and zsh-syntax-highlighting manually:
# git clone https://github.com/zsh-users/zsh-autosuggestions ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-autosuggestions
# git clone https://github.com/zsh-users/zsh-syntax-highlighting.git ${ZSH_CUSTOM:-~/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting
plugins=(
  git
  docker
  docker-compose
  kubectl
  aws
  terraform
  helm
  golang
  python
  node
  vscode
  zsh-autosuggestions
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# User configuration
export LANG=en_US.UTF-8
export EDITOR='vim'

# Load additional config files if they exist
for file in ~/.zsh/configs/*.zsh(N); do
  source "$file"
done

# NVM (Node Version Manager) setup if installed
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Pyenv setup if installed
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi

################ ASDF if installed
[ -f "$HOME/.asdf/asdf.sh" ] && . "$HOME/.asdf/asdf.sh"
[ -d "${ASDF_DIR}/completions" ] && fpath=(${ASDF_DIR}/completions $fpath)

# Navigation & General Aliases
# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ~='cd ~'
alias -- -='cd -'

# List directory contents
alias ll='ls -lh'
alias la='ls -lha'
alias l='ls -CF'
alias lt='ls -lt'   # sort by time
alias ltr='ls -ltr' # sort by time, reverse
alias lsr='ls -lR'  # recursive ls
alias lsz='ls -lSr' # sort by size

# File operations
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'
alias mkdir='mkdir -pv'

# Common typos
alias cd..='cd ..'

# Quick source/edit zshrc
alias sz='source ~/.zshrc'
alias ez='$EDITOR ~/.zshrc'

# System info
alias meminfo='free -m -l -t'
alias df='df -h'
alias du='du -h -c'
alias top='htop'
alias path='echo -e ${PATH//:/\\n}'

# Git shortcuts
alias g='git'
alias ga='git add'
alias gaa='git add --all'
alias gau='git add -u'  # Add only tracked files
alias gap='git add -p'  # Interactive staging
alias gb='git branch'
alias gba='git branch -a'  # List all branches
alias gbd='git branch -d'  # Delete branch
alias gbD='git branch -D'  # Force delete branch
alias gbl='git blame -b -w'  # Show what revision and author last modified each line

# Git commit
alias gc='git commit -v'
alias gcm='git commit -m'
alias gca='git commit -v --amend'
alias gcan='git commit -v --amend --no-edit'  # Amend without editing message
alias gcane='git commit --amend --no-edit'  # Amend without editing message and without verbose

# Git checkout
alias gco='git checkout'
alias gcob='git checkout -b'
alias gcom='git checkout main || git checkout master'  # Checkout main/master
alias gcod='git checkout develop'  # Checkout develop

# Git diff
alias gd='git diff'
alias gds='git diff --staged'
alias gdw='git diff --word-diff'  # Show word diff
alias gdca='git diff --cached'  # Show staged changes
alias gdcw='git diff --cached --word-diff'  # Show staged changes word diff
alias gdt='git diff-tree --no-commit-id --name-only -r'  # Show changed files

# Git fetch/pull/push
alias gf='git fetch'
alias gfa='git fetch --all --prune'  # Fetch all remotes and prune
alias gfo='git fetch origin'  # Fetch from origin
alias gl='git pull'
alias glr='git pull --rebase'  # Pull with rebase
alias gp='git push'
alias gpf='git push --force-with-lease'  # Safer force push
alias gpsup='git push --set-upstream origin $(git_current_branch)'
alias gpv='git push --no-verify'  # Push without hooks

# Git log
alias glo='git log --oneline'
alias glog='git log --oneline --decorate --graph'
alias gloga='git log --oneline --decorate --graph --all'
alias glp='git log -p'  # Show log with patches
alias glstat='git log --stat'  # Show log with stats
alias glsig='git log --show-signature'  # Show log with signatures

# Git rebase
alias grb='git rebase'
alias grba='git rebase --abort'
alias grbc='git rebase --continue'
alias grbi='git rebase -i'  # Interactive rebase
alias grbm='git rebase $(git_main_branch)'  # Rebase on main/master
alias grbd='git rebase develop'  # Rebase on develop

# Git status and info
alias gst='git status'
alias gss='git status -s'  # Short status
alias gsb='git status -sb'  # Short status with branch info
alias gsh='git show'  # Show last commit
alias gsps='git show --pretty=short --show-signature'  # Show signature verification

# Git stash
alias gsta='git stash push'
alias gstaa='git stash apply'
alias gstc='git stash clear'
alias gstd='git stash drop'
alias gstl='git stash list'
alias gstp='git stash pop'
alias gsts='git stash show --text'

# Git tag
alias gt='git tag'
alias gta='git tag -a'  # Create annotated tag
alias gtl='git tag --list'  # List tags
alias gtd='git tag --delete'  # Delete tag

# Git workflows
alias gclean='git clean -fd'  # Remove untracked files/directories
alias greset='git reset --hard HEAD'  # Reset to HEAD
alias gsync='git fetch origin && git pull'  # Sync with origin
alias gundo='git reset --soft HEAD~1'  # Undo last commit
alias gwip='git add -A; git commit -m "WIP" --no-verify'  # Create WIP commit
alias gunwip='git reset HEAD~1'  # Undo WIP commit
alias gprune='git fetch -p && git branch -vv | grep '\''origin/.*: gone]'\'' | awk '\''{print $1}'\'' | xargs git branch -D'  # Remove deleted remote branches
alias gpristine='git reset --hard && git clean -dffx'  # Reset to pristine state
alias gfixup='git commit --fixup'  # Create fixup commit
alias gsquash='git rebase -i --autosquash'  # Squash fixup commits

