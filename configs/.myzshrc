# Load AWS SSO profiles
awssso-login() {
  local profile="${1:-default}"
  aws sso login --profile "$profile"
}

awssso-logout() {
  aws sso logout
}

# AWS Dynamic Profile Functions
_aws_profiles() {
  local profiles_file="$HOME/.aws/config"
  if [[ -r "$profiles_file" ]]; then
    grep '\[profile' "$profiles_file" | sed -e 's/\[profile \(.*\)\]/\1/g'
  fi
}

aws-profile() {
  export AWS_PROFILE="$1"
  echo "Switched to AWS profile: $AWS_PROFILE"
  aws sts get-caller-identity --query "Account" --output text
}

# AWS profile completion
_aws_profile_completion() {
  reply=($(_aws_profiles))
}
compctl -K _aws_profile_completion aws-profile

# AWS Region switching
aws-region() {
  export AWS_REGION="$1"
  echo "Switched to AWS region: $AWS_REGION"
}

# Common AWS regions for completion
_aws_regions() {
  echo "us-east-1 us-east-2 us-west-1 us-west-2 eu-west-1 eu-west-2 eu-central-1 ap-northeast-1 ap-northeast-2 ap-southeast-1 ap-southeast-2 sa-east-1 ca-central-1"
}

_aws_region_completion() {
  reply=($(_aws_regions))
}
compctl -K _aws_region_completion aws-region

# Special DevOps Functions
# EC2 Troubleshooting Bundle
ec2-troubleshoot() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: ec2-troubleshoot [instance-id]"
    return 1
  fi
  
  local instance_id="$1"
  local profile="$AWS_PROFILE"
  
  echo "🔍 Running EC2 troubleshooting for instance $instance_id (profile: $profile)"
  echo "----------------------------------------"
  
  # Get basic instance info
  echo "📋 INSTANCE DETAILS:"
  aws ec2 describe-instances --instance-ids "$instance_id" \
    --query "Reservations[0].Instances[0].{ID:InstanceId,Name:Tags[?Key=='Name'].Value|[0],Type:InstanceType,State:State.Name,AZ:Placement.AvailabilityZone,VPC:VpcId,SubnetId:SubnetId,PrivateIP:PrivateIpAddress,PublicIP:PublicIpAddress,LaunchTime:LaunchTime}" \
    --output table
  
  # Check status
  echo -e "\n📊 SYSTEM STATUS:"
  aws ec2 describe-instance-status --instance-ids "$instance_id" \
    --query "InstanceStatuses[0].{InstanceStatus:InstanceStatus.Status,SystemStatus:SystemStatus.Status,ReachabilityStatus:InstanceState.Name}" \
    --output table
  
  # Security Groups
  echo -e "\n🔒 SECURITY GROUPS:"
  aws ec2 describe-instances --instance-ids "$instance_id" \
    --query "Reservations[0].Instances[0].SecurityGroups[*].{ID:GroupId,Name:GroupName}" \
    --output table
  
  # Check CloudWatch metrics (CPU, Status)
  echo -e "\n📈 CPU UTILIZATION (Last 30 minutes):"
  aws cloudwatch get-metric-statistics --namespace AWS/EC2 --metric-name CPUUtilization \
    --dimensions Name=InstanceId,Value="$instance_id" \
    --statistics Average Maximum --period 300 \
    --start-time "$(date -u -d '-30 minutes' '+%Y-%m-%dT%H:%M:%SZ')" \
    --end-time "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    --output table
  
  # Check if instance has SSM agent
  echo -e "\n🛠️ SSM STATUS:"
  aws ssm describe-instance-information --filters "Key=InstanceIds,Values=$instance_id" \
    --query "InstanceInformationList[*].{Status:PingStatus,Platform:PlatformName,Version:PlatformVersion,Agent:AgentVersion}" \
    --output table
  
  # Get recent SSM command history if available
  echo -e "\n📜 RECENT SSM COMMANDS:"
  aws ssm list-commands \
    --filters "Key=target-id,Values=$instance_id" \
    --query "Commands[0:5].{ID:CommandId,Status:Status,Document:DocumentName,Executed:RequestedDateTime}" \
    --output table
  
  # Check if instance is in an Auto Scaling group
  echo -e "\n⚖️ AUTO SCALING GROUP:"
  asg_name=$(aws autoscaling describe-auto-scaling-instances \
    --instance-ids "$instance_id" \
    --query "AutoScalingInstances[0].AutoScalingGroupName" \
    --output text)
  
  if [[ "$asg_name" != "None" && -n "$asg_name" ]]; then
    echo "Instance belongs to ASG: $asg_name"
    aws autoscaling describe-auto-scaling-groups \
      --auto-scaling-group-names "$asg_name" \
      --query "AutoScalingGroups[0].{Name:AutoScalingGroupName,MinSize:MinSize,MaxSize:MaxSize,DesiredCapacity:DesiredCapacity,HealthCheck:HealthCheckType}" \
      --output table
  else
    echo "Instance is not part of an Auto Scaling group"
  fi
  
  # Check systems manager parameters related to this instance (by name tag)
  instance_name=$(aws ec2 describe-instances --instance-ids "$instance_id" \
    --query "Reservations[0].Instances[0].Tags[?Key=='Name'].Value | [0]" \
    --output text)
  
  if [[ "$instance_name" != "None" && -n "$instance_name" ]]; then
    echo -e "\n⚙️ RELATED SSM PARAMETERS (by name):"
    aws ssm describe-parameters \
      --parameter-filters "Key=Name,Option=Contains,Values=$instance_name" \
      --query "Parameters[*].{Name:Name,Type:Type,LastModified:LastModifiedDate}" \
      --output table
  fi
  
  # Console output
  echo -e "\n💻 LAST CONSOLE OUTPUT (TRUNCATED):"
  aws ec2 get-console-output --instance-id "$instance_id" --output text | tail -20
  
  echo -e "\n✅ TROUBLESHOOTING COMPLETE"
  echo "For SSM session: awsssm $instance_id"
  echo "For SSH access (if applicable): awssh $instance_id"
}

# K8s Diagnostics
k8s-pod-troubleshoot() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: k8s-pod-troubleshoot [pod-name] [namespace]"
    return 1
  fi
  
  local pod="$1"
  local namespace="${2:-default}"
  
  echo "🔍 Running Kubernetes pod troubleshooting for $pod in $namespace namespace"
  echo "----------------------------------------"
  
  # Get basic pod info
  echo "📋 POD DETAILS:"
  kubectl get pod "$pod" -n "$namespace" -o wide
  
  # Describe the pod
  echo -e "\n📊 POD DESCRIPTION:"
  kubectl describe pod "$pod" -n "$namespace" | grep -E "^  (Type|Reason|Message|First Seen|Last Seen):|^Events:|^Warning|^  Normal|^  Warning" | tail -10
  
  # Pod resource usage
  echo -e "\n📈 RESOURCE USAGE:"
  kubectl top pod "$pod" -n "$namespace" 2>/dev/null || echo "Resource metrics not available"
  
  # Pod logs
  echo -e "\n📜 RECENT LOGS:"
  kubectl logs --tail=20 "$pod" -n "$namespace" 2>/dev/null || echo "No logs available"
  
  # Pod events
  echo -e "\n🔔 POD EVENTS:"
  kubectl get events --field-selector involvedObject.name="$pod" -n "$namespace" --sort-by='.lastTimestamp' | tail -10
  
  # Pod containers
  echo -e "\n🧪 CONTAINER STATUS:"
  kubectl get pod "$pod" -n "$namespace" -o jsonpath='{.status.containerStatuses[*].name}{"\t"}{.status.containerStatuses[*].ready}{"\t"}{.status.containerStatuses[*].restartCount}{"\n"}'
  
  # Pod volumes
  echo -e "\n💾 VOLUMES:"
  kubectl describe pod "$pod" -n "$namespace" | grep -A 10 "Volumes:"
  
  echo -e "\n✅ POD DIAGNOSTICS COMPLETE"
  echo "For shell access: kubectl exec -it $pod -n $namespace -- sh"
  echo "For full logs: kubectl logs $pod -n $namespace"
}

# Combined AWS+K8s EKS diagnostics
eks-diagnostics() {
  local cluster="$1"
  local profile="$AWS_PROFILE"
  
  echo "🔍 Running EKS Cluster diagnostics for $cluster using profile $profile"
  echo "----------------------------------------"
  
  # Get cluster info
  echo "📋 CLUSTER DETAILS:"
  aws eks describe-cluster --name "$cluster" \
    --query "cluster.{Name:name,Status:status,Version:version,Endpoint:endpoint,RoleARN:roleArn,VPC:resourcesVpcConfig.vpcId}" \
    --output table
  
  # Get nodegroups
  echo -e "\n📊 NODEGROUPS:"
  aws eks list-nodegroups --cluster-name "$cluster" --output text | while read -r nodegroup; do
    aws eks describe-nodegroup --cluster-name "$cluster" --nodegroup-name "$nodegroup" \
      --query "nodegroup.{Name:nodegroupName,Status:status,Type:instanceTypes[0],MinSize:scalingConfig.minSize,MaxSize:scalingConfig.maxSize,DesiredSize:scalingConfig.desiredSize,DiskSize:diskSize}" \
      --output table
  done
  
  # Connect kubectl to the cluster
  echo -e "\n🔗 CONNECTING TO CLUSTER..."
  aws eks update-kubeconfig --name "$cluster" --alias "$cluster"
  
  # Check nodes
  echo -e "\n🖥️ NODE STATUS:"
  kubectl get nodes -o wide
  
  # Check system pods
  echo -e "\n🧪 SYSTEM PODS:"
  kubectl get pods -n kube-system
  
  # Check namespaces
  echo -e "\n📁 NAMESPACES:"
  kubectl get namespaces
  
  # Check deployments across all namespaces
  echo -e "\n🚀 DEPLOYMENTS:"
  kubectl get deployments --all-namespaces -o wide | head -10
  echo "(Showing first 10 deployments)"
  
  # Check cluster events
  echo -e "\n🔔 RECENT CLUSTER EVENTS:"
  kubectl get events --sort-by='.lastTimestamp' | tail -10
  
  # Check cluster health
  echo -e "\n💓 CLUSTER HEALTH:"
  kubectl get componentstatuses
  
  echo -e "\n✅ EKS DIAGNOSTICS COMPLETE"
  echo "Current kubectl context set to $cluster"
}

# Generate temporary AWS credentials
aws-assume-role() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: aws-assume-role [role-arn] [session-name]"
    return 1
  fi
  
  local role_arn="$1"
  local session_name="${2:-$(whoami)-$(date +%s)}"
  local output
  
  echo "Assuming role: $role_arn"
  echo "Session name: $session_name"
  
  output=$(aws sts assume-role --role-arn "$role_arn" --role-session-name "$session_name" --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' --output text)
  
  if [ $? -ne 0 ]; then
    echo "Failed to assume role."
    return 1
  fi
  
  # Parse output into environment variables
  export AWS_ACCESS_KEY_ID=$(echo "$output" | awk 'NR==1{print $1}')
  export AWS_SECRET_ACCESS_KEY=$(echo "$output" | awk 'NR==1{print $2}')
  export AWS_SESSION_TOKEN=$(echo "$output" | awk 'NR==1{print $3}')
  
  echo "Temporary credentials set in current shell environment."
  echo "Credentials will expire: $(aws sts get-caller-identity --query "ResponseMetadata.HTTPHeaders.date" --output text)"
  echo ""
  echo "Current identity: $(aws sts get-caller-identity --query "Arn" --output text)"
}

