# AWS Profile Management
alias awsp='export AWS_PROFILE='
alias awswho='aws sts get-caller-identity'
alias awsregion='export AWS_REGION='
alias awsls-profiles='aws configure list-profiles'
alias awsusage='aws ce get-cost-and-usage --time-period Start=$(date -d "1 month ago" +%Y-%m-01),End=$(date +%Y-%m-01) --granularity MONTHLY --metrics "BlendedCost" --output table'

# AWS Profile Functions - allows calling any AWS command with a specific profile
awsrun() {
  local profile="$1"
  shift
  AWS_PROFILE="$profile" aws "$@"
}

# EC2 Instance Management
# List all EC2 instances with detailed information
alias awsls-ec2='aws ec2 describe-instances --query "Reservations[*].Instances[*].{ID:InstanceId,Name:Tags[?Key==\`Name\`].Value|[0],Type:InstanceType,State:State.Name,PrivateIP:PrivateIpAddress,PublicIP:PublicIpAddress,LaunchTime:LaunchTime,AZ:Placement.AvailabilityZone,SecurityGroups:join(\`,\`, SecurityGroups[].GroupName)}" --output table'

# List running EC2 instances only
alias awsls-ec2-running='aws ec2 describe-instances --filters "Name=instance-state-name,Values=running" --query "Reservations[*].Instances[*].{ID:InstanceId,Name:Tags[?Key==\`Name\`].Value|[0],Type:InstanceType,PrivateIP:PrivateIpAddress,PublicIP:PublicIpAddress,LaunchTime:LaunchTime,AZ:Placement.AvailabilityZone}" --output table'

# List stopped EC2 instances only
alias awsls-ec2-stopped='aws ec2 describe-instances --filters "Name=instance-state-name,Values=stopped" --query "Reservations[*].Instances[*].{ID:InstanceId,Name:Tags[?Key==\`Name\`].Value|[0],Type:InstanceType,State:State.Name}" --output table'

# Show EC2 instance by Name tag (requires parameter)
awsls-ec2-name() {
  aws ec2 describe-instances --filters "Name=tag:Name,Values=*$1*" --query "Reservations[*].Instances[*].{ID:InstanceId,Name:Tags[?Key==\`Name\`].Value|[0],Type:InstanceType,State:State.Name,PrivateIP:PrivateIpAddress,PublicIP:PublicIpAddress}" --output table
}

# Show EC2 instances by tag key/value
awsls-ec2-tag() {
  if [ "$#" -ne 2 ]; then
    echo "Usage: awsls-ec2-tag [tag-key] [tag-value]"
    return 1
  fi
  aws ec2 describe-instances --filters "Name=tag:$1,Values=*$2*" --query "Reservations[*].Instances[*].{ID:InstanceId,Name:Tags[?Key==\`Name\`].Value|[0],Type:InstanceType,State:State.Name,PrivateIP:PrivateIpAddress}" --output table
}

# List instances by security group
awsls-ec2-sg() {
  aws ec2 describe-instances --filters "Name=instance.group-name,Values=*$1*" --query "Reservations[*].Instances[*].{ID:InstanceId,Name:Tags[?Key==\`Name\`].Value|[0],Type:InstanceType,State:State.Name,SG:SecurityGroups[*].GroupName}" --output table
}

# List EC2 instance status
alias awsls-ec2-status='aws ec2 describe-instance-status --query "InstanceStatuses[*].{ID:InstanceId,Status:InstanceStatus.Status,SystemStatus:SystemStatus.Status,AZ:AvailabilityZone}" --output table'

# Get EC2 console output
awsec2-console() {
  aws ec2 get-console-output --instance-id "$1" --output text
}

# Start, stop, reboot, terminate EC2 instances
awsec2-start() {
  aws ec2 start-instances --instance-ids "$1"
  aws ec2 describe-instances --instance-ids "$1" --query "Reservations[*].Instances[*].{ID:InstanceId,State:State.Name}" --output table
}

awsec2-stop() {
  aws ec2 stop-instances --instance-ids "$1"
  aws ec2 describe-instances --instance-ids "$1" --query "Reservations[*].Instances[*].{ID:InstanceId,State:State.Name}" --output table
}

awsec2-reboot() {
  aws ec2 reboot-instances --instance-ids "$1"
  sleep 5
  aws ec2 describe-instances --instance-ids "$1" --query "Reservations[*].Instances[*].{ID:InstanceId,State:State.Name}" --output table
}

awsec2-terminate() {
  echo "Are you sure you want to terminate instance $1? (y/n)"
  read confirm
  if [[ $confirm == "y" || $confirm == "Y" ]]; then
    aws ec2 terminate-instances --instance-ids "$1"
    aws ec2 describe-instances --instance-ids "$1" --query "Reservations[*].Instances[*].{ID:InstanceId,State:State.Name}" --output table
  fi
}

# Detailed EC2 Instance Info
awsec2-info() {
  aws ec2 describe-instances --instance-ids "$1" --output json | jq '.'
}

# Get instance user data
awsec2-userdata() {
  aws ec2 describe-instance-attribute --instance-id "$1" --attribute userData --output text --query "UserData.Value" | base64 --decode
}

# EC2 Monitoring 
awsec2-cpu() {
  local instance_id="$1"
  local minutes="${2:-60}"
  aws cloudwatch get-metric-statistics --namespace AWS/EC2 --metric-name CPUUtilization \
    --dimensions Name=InstanceId,Value="$instance_id" \
    --statistics Average --period 300 \
    --start-time "$(date -u -d "-$minutes minutes" +%Y-%m-%dT%H:%M:%SZ)" \
    --end-time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --output table
}

awsec2-mem() {
  local instance_id="$1"
  local minutes="${2:-60}"
  aws cloudwatch get-metric-statistics --namespace CWAgent --metric-name mem_used_percent \
    --dimensions Name=InstanceId,Value="$instance_id" \
    --statistics Average --period 300 \
    --start-time "$(date -u -d "-$minutes minutes" +%Y-%m-%dT%H:%M:%SZ)" \
    --end-time "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --output table
}

# SSM Session Manager - Profile aware
alias awsip='curl http://checkip.amazonaws.com/'

awsssm() {
  local instance_id="$1"
  local profile="$AWS_PROFILE"
  
  if [ -z "$profile" ]; then
    echo "No AWS_PROFILE set. Usage: AWS_PROFILE=<profile> awsssm <instance-id>"
    return 1
  fi
  
  echo "Starting SSM session to $instance_id using profile $profile"
  aws ssm start-session --target "$instance_id"
}

# Run SSM command and retrieve output
awsssm-run() {
  if [ "$#" -lt 2 ]; then
    echo "Usage: awsssm-run <instance-id> \"<command>\""
    return 1
  fi
  
  local instance_id="$1"
  local command="$2"
  local cmd_id
  
  echo "Running command on $instance_id: $command"
  cmd_id=$(aws ssm send-command \
    --instance-ids "$instance_id" \
    --document-name "AWS-RunShellScript" \
    --parameters "commands=[\"$command\"]" \
    --output text \
    --query "Command.CommandId")
  
  echo "Command ID: $cmd_id"
  echo "Waiting for command to complete..."
  aws ssm wait command-executed --command-id "$cmd_id" --instance-id "$instance_id"
  
  echo "Command output:"
  aws ssm get-command-invocation \
    --command-id "$cmd_id" \
    --instance-id "$instance_id" \
    --query "StandardOutputContent" \
    --output text
}

# List available SSM managed instances
alias awsls-ssm='aws ssm describe-instance-information --query "InstanceInformationList[*].{InstanceId:InstanceId,PingStatus:PingStatus,PlatformName:PlatformName,PlatformVersion:PlatformVersion,AgentVersion:AgentVersion}" --output table'

# List SSM parameters (with decryption)
alias awsls-params='aws ssm describe-parameters --query "Parameters[*].{Name:Name,Type:Type,LastModified:LastModifiedDate}" --output table'

awsget-param() {
  aws ssm get-parameter --name "$1" --with-decryption --query "Parameter.Value" --output text
}

# EC2 Security Groups
alias awsls-sg='aws ec2 describe-security-groups --query "SecurityGroups[*].{ID:GroupId,Name:GroupName,VPC:VpcId}" --output table'

awssg-info() {
  aws ec2 describe-security-groups --group-ids "$1" | jq '.'
}

awssg-rules() {
  aws ec2 describe-security-groups --group-ids "$1" --query "SecurityGroups[*].{GroupName:GroupName,IpPermissions:IpPermissions[*].{Protocol:IpProtocol,FromPort:FromPort,ToPort:ToPort,IpRanges:IpRanges[*].CidrIp}}" --output table
}

# EC2 AMI Management
alias awsls-ami='aws ec2 describe-images --owners self --query "Images[*].{ID:ImageId,Name:Name,Created:CreationDate,State:State}" --output table'

awsami-info() {
  aws ec2 describe-images --image-ids "$1" | jq '.'
}

# S3 operations
alias s3ls='aws s3 ls'
alias s3cp='aws s3 cp'
alias s3sync='aws s3 sync'
alias s3rm='aws s3 rm'

s3ls-bucket() {
  aws s3 ls "s3://$1/" --recursive --human-readable --summarize
}

s3size() {
  aws s3 ls "s3://$1/" --recursive --human-readable --summarize | grep "Total Size"
}

s3find() {
  if [ "$#" -ne 2 ]; then
    echo "Usage: s3find [bucket] [search-pattern]"
    return 1
  fi
  aws s3 ls "s3://$1/" --recursive | grep "$2"
}

# ECS commands
alias ecsls='aws ecs list-clusters'
alias ecssvc='aws ecs list-services --cluster'
alias ecstasks='aws ecs list-tasks --cluster'

ecsls-services() {
  aws ecs list-services --cluster "$1" --query "serviceArns" --output text
}

ecsls-tasks() {
  aws ecs list-tasks --cluster "$1" --service-name "$2" --query "taskArns" --output text
}

ecsdesc-service() {
  aws ecs describe-services --cluster "$1" --services "$2" | jq '.'
}

ecsdesc-task() {
  aws ecs describe-task-definition --task-definition "$1" | jq '.'
}

# CloudWatch Logs
awslogs-groups() {
  aws logs describe-log-groups --query "logGroups[*].{Name:logGroupName,RetentionDays:retentionInDays}" --output table
}

awslogs-streams() {
  aws logs describe-log-streams --log-group-name "$1" --query "logStreams[*].{Name:logStreamName,LastEvent:lastEventTimestamp}" --output table
}

awslogs-get() {
  if [ "$#" -lt 2 ]; then
    echo "Usage: awslogs-get [log-group] [log-stream] [start-time] [end-time]"
    echo "Time format: YYYY-MM-DD HH:MM:SS (in UTC)"
    return 1
  fi
  
  local group="$1"
  local stream="$2"
  local start_time="$3"
  local end_time="$4"
  local start_ts end_ts
  
  if [ -n "$start_time" ]; then
    start_ts=$(date -u -d "$start_time" +%s)000
    start_args="--start-time $start_ts"
  else
    start_args=""
  fi
  
  if [ -n "$end_time" ]; then
    end_ts=$(date -u -d "$end_time" +%s)000
    end_args="--end-time $end_ts"
  else
    end_args=""
  fi
  
  aws logs get-log-events --log-group-name "$group" --log-stream-name "$stream" $start_args $end_args --output text --query "events[*].[timestamp,message]"
}

awslogs-tail() {
  local minutes="${2:-10}"
  aws logs get-log-events --log-group-name "$1" --limit 100 \
    --start-time $(( $(date +%s) - $minutes * 60 ))000 \
    --output text --query "events[*].[timestamp,message]"
}

# Lambda Functions
alias awsls-lambda='aws lambda list-functions --query "Functions[*].{Name:FunctionName,Runtime:Runtime,Memory:MemorySize,Timeout:Timeout,LastModified:LastModified}" --output table'

awslambda-info() {
  aws lambda get-function --function-name "$1" | jq '.'
}

awslambda-logs() {
  local function_name="$1"
  local minutes="${2:-60}"
  local start_time=$(date -u -d "-$minutes minutes" +%Y-%m-%dT%H:%M:%SZ)
  
  aws logs filter-log-events \
    --log-group-name "/aws/lambda/$function_name" \
    --start-time "$(date -u -d "$start_time" +%s)000" \
    --output text --query "events[*].[timestamp,message]" | sort
}

# VPC resources
alias awsls-vpc='aws ec2 describe-vpcs --query "Vpcs[*].{ID:VpcId,CIDR:CidrBlock,Name:Tags[?Key==\`Name\`].Value|[0],IsDefault:IsDefault}" --output table'
alias awsls-subnets='aws ec2 describe-subnets --query "Subnets[*].{ID:SubnetId,VPC:VpcId,CIDR:CidrBlock,AZ:AvailabilityZone,Public:MapPublicIpOnLaunch}" --output table'
alias awsls-rtb='aws ec2 describe-route-tables --query "RouteTables[*].{ID:RouteTableId,VPC:VpcId}" --output table'
alias awsls-igw='aws ec2 describe-internet-gateways --query "InternetGateways[*].{ID:InternetGatewayId,Attachments:Attachments[*].VpcId}" --output table'
